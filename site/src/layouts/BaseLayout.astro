---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import { href } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  doc?: boolean;
}

const {
  title,
  description = "gojo schedules, runs, and audits autonomous coding agents against your Git repositories.",
  doc = false,
} = Astro.props;

const pageTitle = title === "gojo" ? "gojo" : `${title} · gojo`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main class:list={["site-main", { "doc-wrap": doc }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div>
          <strong class="brand brand-footer">gojo</strong>
          <p class="footer-blurb">Self-hosted agent operations for Git repositories.</p>
        </div>
        <div>
          <a href={href("/getting-started")}>Getting started</a>
          ·
          <a href={href("/first-agent")}>First agent</a>
          ·
          <a href={href("/docs")}>Documentation</a>
        </div>
      </div>
    </footer>
  </body>
</html>
