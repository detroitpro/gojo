---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} doc>
  <h1>{frontmatter.title}</h1>
  {frontmatter.description && <p class="doc-lead">{frontmatter.description}</p>}
  <div class="doc-content">
    <slot />
  </div>
</BaseLayout>
