{
  "name": "gojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scheduled software-agent orchestration platform",
  "workspaces": ["packages/*"],
  "bin": {
    "gojo": "./src/transports/cli/index.ts"
  },
  "scripts": {
    "gojo": "bun run src/transports/cli/index.ts",
    "dev": "bash scripts/dev.sh",
    "dev:server": "bun --watch src/transports/cli/index.ts server start",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "build:web": "bun run --cwd web build",
    "install:cli": "bash scripts/install-cli.sh",
    "check": "bash scripts/ci-check.sh",
    "generate:manifest-schema": "bun run scripts/generate-manifest-json-schema.ts",
    "release:manifest": "bun run scripts/release-manifest.ts",
    "screenshots:ui": "bun run scripts/screenshots/capture.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "cronstrue": "3.24.0",
    "dotenv": "17.4.2",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "1.3.14",
    "dependency-cruiser": "18.1.1",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "zod-to-json-schema": "3.25.2"
  }
}
