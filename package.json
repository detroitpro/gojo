{
  "name": "gojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scheduled software-agent orchestration platform",
  "bin": {
    "gojo": "./src/cli/index.ts"
  },
  "scripts": {
    "gojo": "bun run src/cli/index.ts",
    "dev": "bun run src/cli/index.ts server start",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "build:web": "bun run --cwd web build",
    "check": "bun run typecheck && bun test",
    "release:manifest": "bun run scripts/release-manifest.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "croner": "^9.0.0",
    "ulid": "^2.3.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
